# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1

# 调试开关
DEBUG=false

# ChromaDB / PDF RAG 配置
CHROMA_DB_PATH=D:/path/to/your/chroma_db
CHROMA_COLLECTION_NAME=pdf_chunks

# Embedding 模型，需要和 PDF 入库时使用的模型一致
EMBEDDING_MODEL=text-embedding-3-small

# PDF 检索最低相关度阈值
MIN_PDF_SCORE=0.55